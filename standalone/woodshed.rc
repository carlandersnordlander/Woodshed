#include <windows.h>

// The application's icon, in the two places Windows looks for one.
//
// "1" is what Explorer, the file properties and the installer read off the executable: the shell
// takes the icon group with the lowest ordinal. "GLFW_ICON" is the name GLFW looks up by when it
// registers the window class, and is what puts the icon in the title bar, on the taskbar button
// and in the Alt-Tab list. Same file for both, so there is one icon and not two that drift.
//
// The file is generated from the mark's geometry rather than drawn by hand; see
// design/make-icon.ps1. It carries 16 through 256 pixels, the small sizes using the single-ring
// form of the mark, because three rings at sixteen pixels is three grey lines.
1 ICON "woodshed.ico"
GLFW_ICON ICON "woodshed.ico"

// What Explorer shows under Properties -> Details, and what the installer reads to name and
// version itself rather than being told twice. Without this the file claims to be nothing, made by
// nobody, which is exactly what an unsigned binary should not also look like.
#define WOODSHED_VERSION      0,1,0,0
#define WOODSHED_VERSION_STR  "0.1.0.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     WOODSHED_VERSION
PRODUCTVERSION  WOODSHED_VERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		// 040904b0: US English, Unicode. The language a program's metadata is written in, which is
		// not the same question as what language it is used in.
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName",      "Anders Nordlander"
			VALUE "FileDescription",  "Woodshed - a practice room for guitar and bass"
			VALUE "FileVersion",      WOODSHED_VERSION_STR
			VALUE "InternalName",     "woodshed"
			VALUE "LegalCopyright",   "MIT licensed. Built on NeuralAmpModelerCore, Copyright (c) 2023 Steven Atkinson."
			VALUE "OriginalFilename", "Woodshed.exe"
			VALUE "ProductName",      "Woodshed"
			VALUE "ProductVersion",   WOODSHED_VERSION_STR
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
